{
  "$schema": "https://unpkg.com/knip/schema.json",
  "ignoreFiles": [
    "vitest.integration.config.ts",
    "vitest.setup.ts",
    "public/sw.js",
    "scripts/create-stripe-products.ts",
    "scripts/data-quality-report.ts",
    "integration/**",
    "lib/e2e/**"
  ],
  "ignore": [
    "components/ui/**",
    "__tests__/mocks/**",
    "prisma/seed-data/**",
    "prisma/seeds/**"
  ],
  "ignoreExportsUsedInFile": true,
  "rules": {
    "files": "error",
    "dependencies": "error",
    "unlisted": "error",
    "exports": "warn",
    "types": "warn",
    "duplicates": "off"
  }
}
