{
  "name": "remedi",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.8",
  "prisma": {
    "seed": "bun prisma/seed.ts"
  },
  "scripts": {
    "dev": "next dev",
    "build": "bunx prisma generate && bunx prisma migrate deploy && next build",
    "start": "next start",
    "format:check": "prettier --check \"{app,components,context,hooks,lib,scripts,__tests__,e2e,prisma}/**/*.{ts,tsx,js,jsx,json,css,md}\" \"*.{ts,tsx,js,jsx,json,css,md,mjs,yml,yaml}\"",
    "format:write": "prettier --write \"{app,components,context,hooks,lib,scripts,__tests__,e2e,prisma}/**/*.{ts,tsx,js,jsx,json,css,md}\" \"*.{ts,tsx,js,jsx,json,css,md,mjs,yml,yaml}\"",
    "lint": "eslint .",
    "knip": "DATABASE_URL=${DATABASE_URL:-postgresql://remedi:remedi_dev@localhost:5433/remedi?schema=public} knip",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "analyze": "ANALYZE=true next build",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:report": "playwright show-report",
    "import:fda": "bun run scripts/import-openfda-data.ts",
    "import:fda:dry": "bun run scripts/import-openfda-data.ts --dry-run",
    "import:fda:quick": "bun run scripts/import-openfda-data.ts --limit 50",
    "type-check": "DATABASE_URL=${DATABASE_URL:-postgresql://remedi:remedi_dev@localhost:5433/remedi?schema=public} bunx prisma generate && tsc --noEmit",
    "init": "bunx prisma generate && bunx prisma migrate dev && bunx prisma db seed",
    "db:verify": "bun run scripts/verify-db.ts",
    "db:integrity": "bun run scripts/check-data-integrity.ts",
    "db:baseline": "bunx prisma migrate resolve --applied 20260205094500_baseline_postgres",
    "db:repair:clerk-migration": "bunx prisma migrate resolve --rolled-back 20250207_clerk_migration",
    "health:check": "bun run scripts/health-check.ts",
    "health:check:http": "bun run scripts/health-check-http.ts",
    "prod:check": "bun run scripts/production-check.ts",
    "predeploy": "bun run format:check && bun run lint && bun run type-check && bun run test:run && bun run db:verify && bun run db:integrity && bun run prod:check",
    "quality:check": "bun run format:check && bun run lint && bun run type-check && bun run test:run && bun run test:e2e && bun run db:verify && bun run db:integrity && bun run prod:check",
    "prepare": "husky"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.5.20",
    "@prisma/adapter-pg": "^7.9.0",
    "@prisma/client": "^7.9.0",
    "@radix-ui/react-dialog": "^1.1.20",
    "@radix-ui/react-label": "^2.1.12",
    "@radix-ui/react-scroll-area": "^1.2.15",
    "@radix-ui/react-separator": "^1.1.12",
    "@radix-ui/react-slot": "^1.3.0",
    "@radix-ui/react-switch": "^1.3.4",
    "@radix-ui/react-tabs": "^1.1.18",
    "@react-email/components": "^1.0.12",
    "@sentry/nextjs": "^10.67.0",
    "@tanstack/react-query": "^5.101.4",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "framer-motion": "^12.42.2",
    "lucide-react": "^1.25.0",
    "next": "^16.2.10",
    "next-themes": "^0.4.6",
    "openai": "^6.48.0",
    "pg": "^8.22.0",
    "prisma": "^7.9.0",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "resend": "^6.18.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.7",
    "stripe": "^22.3.2",
    "svix": "^1.98.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@next/bundle-analyzer": "^16.2.10",
    "@next/eslint-plugin-next": "^16.2.10",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^6.10.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.9.5",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/ui": "^4.1.10",
    "eslint": "^10.7.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "knip": "^6.27.0",
    "lint-staged": "^17.1.0",
    "playwright": "^1.61.1",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "vitest related --run"
    ],
    "*.{js,jsx,ts,tsx,json,css,md}": [
      "prettier --write"
    ]
  },
  "trustedDependencies": [
    "@prisma/client",
    "@prisma/engines",
    "@sentry/cli",
    "esbuild",
    "prisma",
    "sharp",
    "unrs-resolver"
  ]
}
