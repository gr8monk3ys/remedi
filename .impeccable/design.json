      "css": ".ds-input{display:block;width:100%;height:40px;padding:8px 12px;border-radius:6px;border:1px solid var(--input,rgba(19,26,21,.14));background:var(--card,#fff);color:var(--foreground,#131a15);font-family:Manrope,ui-sans-serif,system-ui,sans-serif;font-size:14px;transition:border-color .15s,box-shadow .15s}.ds-input::placeholder{color:color-mix(in srgb,var(--muted-foreground,#5c675f) 70%,transparent)}.ds-input:hover{border-color:var(--border-strong,rgba(19,26,21,.18))}.ds-input:focus-visible{outline:none;border-color:color-mix(in srgb,var(--primary,#1f6b45) 60%,transparent);box-shadow:0 0 0 2px color-mix(in srgb,var(--primary,#1f6b45) 15%,transparent)}"
