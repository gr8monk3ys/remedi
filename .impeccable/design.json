      "html": "<span class=\"ds-badge\">Supportive</span> <span class=\"ds-badge ds-badge-secondary\">Basic</span> <span class=\"ds-badge ds-badge-destructive\">Interaction</span>",
      "css": ".ds-badge{display:inline-flex;align-items:center;gap:4px;padding:2px 6px;border-radius:4px;border:1px solid color-mix(in srgb,var(--primary,#1f6b45) 20%,transparent);background:color-mix(in srgb,var(--primary,#1f6b45) 10%,transparent);color:var(--primary,#1f6b45);font-family:\"IBM Plex Mono\",ui-monospace,Menlo,monospace;font-size:11px;line-height:16px;font-weight:500;letter-spacing:.02em}.ds-badge-secondary{border-color:transparent;background:var(--muted,#eef0ec);color:var(--muted-foreground,#5c675f)}.ds-badge-destructive{border-color:color-mix(in srgb,var(--destructive,#b3372b) 25%,transparent);background:color-mix(in srgb,var(--destructive,#b3372b) 10%,transparent);color:var(--destructive,#b3372b)}"
    },
    {
      "name": "Alert",
      "kind": "custom",
      "refersTo": "alert-warning",
      "description": "How the product says \"we could not check\".",
      "html": "<div class=\"ds-alert ds-alert-warning\" role=\"alert\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z\"/><path d=\"M12 9v4\"/><path d=\"M12 17h.01\"/></svg><div><strong>Interaction check unavailable.</strong> We could not reach the interaction service, so this is not an all-clear.</div></div>",
      "css": ".ds-alert{position:relative;display:flex;gap:12px;align-items:flex-start;padding:12px 16px;border-radius:6px;border:1px solid var(--border,rgba(19,26,21,.1));background:var(--card,#fff);color:var(--foreground,#131a15);font-family:Manrope,ui-sans-serif,system-ui,sans-serif;font-size:14px;line-height:1.5}.ds-alert svg{flex:none;margin-top:2px;color:var(--primary,#1f6b45)}.ds-alert strong{font-weight:600}.ds-alert-warning{border-color:color-mix(in srgb,var(--warning,#9a6a12) 30%,transparent);background:color-mix(in srgb,var(--warning,#9a6a12) 5%,transparent)}.ds-alert-warning svg{color:var(--warning,#9a6a12)}"
    },
